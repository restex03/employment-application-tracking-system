{
    "name": "employement-application-and-alignment-tracking-system",
    "version": "1.0.0",
    "description": "AI-powered employment application & alignment tracking system that automates job screening, evaluation, and compatibility scoring for job seekers",
    "license": "ISC",
    "author": "",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "start": "tsx src/main.ts",
        "typecheck": "tsc --noEmit",
        "unused-types": "knip --tags=types",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "vitest",
        "test:run": "vitest run",
        "verify": "npm run typecheck && npm run test:run",
        "frontend:dev": "cd client && npm run dev",
        "frontend:build": "cd client && npm run build",
        "frontend:preview": "cd client && npm run preview",
        "dev:full": "concurrently \"npm run dev\" \"npm run frontend:dev\""
    },
    "knip": {
        "ignoreDependencies": [
            "dotenv"
        ]
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.2.0",
        "@types/sanitize-html": "^2.16.1",
        "@types/uuid": "^10.0.0",
        "concurrently": "^8.2.2",
        "knip": "^6.33.0",
        "prettier": "3.9.6",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "better-sqlite3": "^13.0.3",
        "dotenv": "^17.4.2",
        "fastify": "^5.12.1",
        "openai": "^7.5.0",
        "sanitize-html": "^2.17.7",
        "zod": "^4.4.3"
    }
}
