{
    "name": "job-app-helper",
    "version": "1.0.0",
    "description": "simple app to assist job searchers applying for jobs",
    "license": "ISC",
    "author": "",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "typecheck": "tsc --noEmit",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "vitest",
        "test:run": "vitest run",
        "verify": "npm run typecheck && npm run test:run"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "prettier": "3.9.6",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "cheerio": "^1.2.0",
        "dotenv": "^17.4.2",
        "openai": "^7.5.0",
        "zod": "^4.4.3"
    }
}
