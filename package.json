{
    "name": "employment-application-tracking-system",
    "version": "1.0.0",
    "description": "AI-powered employment application tracking system that automates job screening, evaluation, and compatibility scoring for job seekers",
    "license": "ISC",
    "author": "",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "start:tee": "npm start 2>&1 | tee output.txt",
        "typecheck": "tsc --noEmit",
        "unused-types": "knip --tags=types",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "vitest",
        "test:run": "vitest run",
        "verify": "npm run typecheck && npm run test:run"
    },
    "knip": {
        "ignoreDependencies": [
            "dotenv"
        ]
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.2.0",
        "knip": "^6.33.0",
        "prettier": "3.9.6",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "better-sqlite3": "^13.0.3",
        "dotenv": "^17.4.2",
        "openai": "^7.5.0",
        "zod": "^4.4.3"
    }
}
