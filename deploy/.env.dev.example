# Copy to deploy/.env for Fedora development. Never commit deploy/.env.
# Matches the old devScripts/infrastart.sh database credentials.
# Change the password only after updating the existing PostgreSQL role.
POSTGRES_PASSWORD=eats_dev_password

# Absolute path to the sources JSON file on THIS machine.
WORKDAY_SOURCES_HOST_PATH=/absolute/path/to/EATS/apps/web/data/JobSources/workdaySources.json

# Required by the shared Compose file during interpolation; the dev
# override publishes localhost-only, not this LAN address.
LAN_IP=127.0.0.2

POSTGRES_HOST_PORT=5432
INGESTION_HOST_PORT=8080
INGESTION_IMAGE_TAG=0.1.21
INGESTION_TIME_ZONE=America/New_York
