# Copy to .env in your deployment directory. Never commit real credentials.
POSTGRES_PASSWORD=replace-with-a-strong-password

# Use an absolute path on the deployment host.
WORKDAY_SOURCES_HOST_PATH=/path/to/config/workdaySources.json

# Both services publish on localhost and this specific LAN interface.
# Set this to an IPv4 address assigned to the deployment host; do not use 0.0.0.0.
LAN_IP=192.168.1.128
POSTGRES_HOST_PORT=5432
INGESTION_HOST_PORT=8080

# For production GHCR images, use ghcr.io/restex03/eats-ingestion.
# Omit or use eats-ingestion for local builds.
INGESTION_IMAGE_REPOSITORY=ghcr.io/restex03/eats-ingestion
# Pin a published immutable SHA tag, e.g. sha-<40-character-git-commit>.
INGESTION_IMAGE_TAG=sha-REPLACE_WITH_PUBLISHED_COMMIT_SHA
INGESTION_TIME_ZONE=America/New_York
