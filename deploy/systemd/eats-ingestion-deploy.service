[Unit]
Description=Poll GHCR and deploy the latest successful EATS main build
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=eats-deploy
Group=eats-deploy
WorkingDirectory=/opt/eats
ExecStart=/usr/local/bin/nu --no-config-file /opt/eats/deploy.nu
TimeoutStartSec=12min
