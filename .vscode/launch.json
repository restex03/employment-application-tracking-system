{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Backend",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/apps/web/src/main.ts",
            "sourceMaps": true,
            "smartStep": true,
            "runtimeArgs": [
                "--import",
                "tsx"
            ],
            "cwd": "${workspaceFolder}/apps/web",
            "console": "integratedTerminal"
        },
        {
            "type": "coreclr",
            "request": "launch",
            "name": "Debug Eats.Ingestion.Tests",
            "program": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/apps/ingestion/tests/Eats.Ingestion.Tests/Eats.Ingestion.Tests.csproj",
                "--nologo"
            ],
            "cwd": "${workspaceFolder}/apps/ingestion",
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "type": "coreclr",
            "request": "launch",
            "name": "Debug Ingestion API (http)",
            "program": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/apps/ingestion/src/Eats.Ingestion/Eats.Ingestion.csproj",
                "--launch-profile",
                "http"
            ],
            "cwd": "${workspaceFolder}/apps/ingestion",
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart"
        }
    ]
}