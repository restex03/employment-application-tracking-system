{
    "compilerOptions": {
        "target": "ES2022",

        "module": "ESNext",
        "moduleResolution": "bundler",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,

        "strict": true,
        "noEmit": true,

        "esModuleInterop": true,
        "skipLibCheck": true,

        "types": ["node"]
    },
    "include": ["src/**/*.ts"]
}
